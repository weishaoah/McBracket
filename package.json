{
  "name": "mcbracket",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "麦门最强餐品争霸赛 — 8 款真实麦当劳餐品，7 场对决，一个冠军。数据来自麦当劳官方 MCP。",
  "scripts": {
    "dev": "vite",
